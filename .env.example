# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables (then redeploy).

# The SAME PostgreSQL database the bot uses (the bot's DATABASE_URL on Render).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Password for signing in to this panel. Use a long, unique one.
ADMIN_PASSWORD=change-me-to-something-long

# The SAME values as the bot. Used to message customers and update your
# Telegram admin card when you approve/reject here.
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
ADMIN_CHAT_ID=123456789

# Shown in the panel and in messages to customers. Same as the bot.
SHOP_NAME=MLBB Diamond Shop
SUPPORT_CONTACT=@your_telegram_username

# Optional: sign sessions with a separate secret. If empty, ADMIN_PASSWORD is
# used, so changing the password signs out every device.
SESSION_SECRET=
